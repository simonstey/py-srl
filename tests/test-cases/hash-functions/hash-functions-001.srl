PREFIX : <http://example.org/>

# Derive normalized identifiers and content fingerprints.
# The MD5/SHA1/SHA256/SHA384/SHA512 builtins were removed from SHACL 1.2
# Rules, so these rules demonstrate assignment using spec-valid string
# built-ins (UCASE, STRLEN, STR, CONCAT, SUBSTR) instead.
RULE { ?item :normalizedId ?norm } WHERE {
    ?item :identifier ?id .
    SET(?norm := UCASE(?id))
}

RULE { ?item :idLength ?len } WHERE {
    ?item :identifier ?id .
    SET(?len := STRLEN(?id))
}

# Create a content fingerprint by combining length and prefix
RULE { ?doc :fingerprint ?fp } WHERE {
    ?doc :content ?content .
    SET(?fp := CONCAT(STR(STRLEN(?content)), "-", SUBSTR(?content, 1, 3)))
}
