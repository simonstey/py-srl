# Rule Format Example 3: RULE/WHERE Form with FILTER
# Demonstrates the Rule1 syntax with a FILTER condition.
# (The former Datalog `:-` form has been removed from SHACL 1.2 Rules.)

PREFIX ex: <http://example.org/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

# Sibling inference: two people who share a parent are siblings
RULE {
    ?x ex:sibling ?y .
} WHERE {
    ?x ex:parent ?p .
    ?y ex:parent ?p .
    FILTER(?x != ?y)
}
