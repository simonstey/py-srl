# Rule Format Example 11: Mixed Format - Multiple Rules
# Demonstrates both rule formats (RULE/WHERE and IF/THEN) in one file.
# (The former Datalog `:-` form has been removed from SHACL 1.2 Rules.)

PREFIX ex: <http://example.org/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

# Rule 1: RULE/WHERE form
RULE {
    ?x ex:knows ?y .
} WHERE {
    ?x ex:friend ?y .
}

# Rule 2: IF/THEN form
IF {
    ?x ex:knows ?y .
    ?y ex:knows ?z .
} THEN {
    ?x ex:indirectlyKnows ?z .
}

# Rule 3: RULE/WHERE form (symmetric knows via friend)
RULE {
    ?x ex:knows ?y .
} WHERE {
    ?y ex:friend ?x .
}
