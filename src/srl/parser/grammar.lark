// SHACL 1.2 Rules - Shape Rule Language (SRL) Grammar
// Based on W3C specification (gh-pages, 2026-07-07 restructuring).
// Productions [1]-[121] and terminals [122]-[156] of shapes-rule-language.bnf.
//
// The grammar is split into THREE production families that differ in what they
// admit, exactly as the current spec requires:
//   * Data     ([28]-[49]) : NO variables, NO paths (ground facts).
//   * Template ([50]-[63]) : variables, NO paths (rule heads).
//   * Pattern  ([64]-[91]) : variables AND paths  (rule bodies).

// [1] RuleSet ::= RuleOrDataBlock
// [2]-[5] Prologue may be interspersed between rules/data blocks.
rule_set: (prologue1 | rule | data)*

// [5] Prologue1 ::= BaseDecl | PrefixDecl | VersionDecl | ImportsDecl
prologue1: base_decl | prefix_decl | version_decl | imports_decl

// [6] BaseDecl ::= 'BASE' IRIREF
base_decl: "BASE"i IRIREF

// [7] PrefixDecl ::= 'PREFIX' PNAME_NS IRIREF
prefix_decl: "PREFIX"i PNAME_NS IRIREF

// [8] VersionDecl ::= 'VERSION' VersionSpecifier
version_decl: "VERSION"i version_specifier

// [9] VersionSpecifier ::= STRING_LITERAL1 | STRING_LITERAL2
version_specifier: STRING_LITERAL1 | STRING_LITERAL2

// [10] ImportsDecl ::= 'IMPORTS' iri
imports_decl: "IMPORTS"i iri

// [11] Rule ::= Rule1 | Rule2 | Declaration
rule: rule1 | rule2 | declaration

// [12] Rule1 ::= 'RULE' iri? HeadTemplate 'WHERE' BodyPattern
rule1: "RULE"i iri? head_template "WHERE"i body_pattern

// [13] Rule2 ::= 'IF' BodyPattern 'THEN' HeadTemplate
rule2: "IF"i body_pattern "THEN"i head_template

// [27] Declaration ::= 'TRANSITIVE' '(' iri ')'
//                    | '(' iri ')' 'SYMMETRIC'
//                    | 'INVERSE' '(' iri ',' iri ')'
declaration: transitive_decl | symmetric_decl | inverse_decl
transitive_decl: "TRANSITIVE"i "(" iri ")"
symmetric_decl: "(" iri ")" "SYMMETRIC"i
inverse_decl: "INVERSE"i "(" iri "," iri ")"

// ============================================================================
// Data family [14], [28]-[49] : ground triples (NO variables, NO paths)
// ============================================================================

// [14] Data ::= 'DATA' '{' DataTriplesBlock? '}'
data: "DATA"i "{" data_triples_block? "}"

// [28] DataTriplesBlock ::= TriplesSameSubjectData ( '.' DataTriplesBlock? )?
data_triples_block: triples_same_subject_data ("." data_triples_block?)?

// [29] TriplesSameSubjectData ::= RDFTermData PropertyListNotEmptyData
triples_same_subject_data: rdf_term_data property_list_not_empty_data

// [31] PropertyListNotEmptyData ::= VerbData ObjectListData ( ';' ( VerbData ObjectListData )? )*
property_list_not_empty_data: verb_data object_list_data (";" (verb_data object_list_data)?)*

// [32] VerbData ::= iri | 'a'
verb_data: iri | TYPE_A

// [33] ObjectListData ::= ObjectData ( ',' ObjectData )*
object_list_data: object_data ("," object_data)*

// [34] ObjectData ::= GraphNodeData
object_data: graph_node_data

// [35] GraphNodeData ::= RDFTermData
graph_node_data: rdf_term_data

// [47] TripleTermData ::= '<<(' TripleTermSubjectData VerbData TripleTermObjectData ')>>'
triple_term_data: "<<(" triple_term_subject_data verb_data triple_term_object_data ")>>"
// [48] TripleTermSubjectData
triple_term_subject_data: iri | rdf_literal | numeric_literal | boolean_literal | blank_node | triple_term_data
// [49] TripleTermObjectData
triple_term_object_data: iri | rdf_literal | numeric_literal | boolean_literal | blank_node | triple_term_data

// [92] RDFTermData ::= iri | RDFLiteral | NumericLiteral | BooleanLiteral | BlankNode | NIL | TripleTermData
rdf_term_data: iri | rdf_literal | numeric_literal | boolean_literal | blank_node | NIL | triple_term_data

// ============================================================================
// Template family [15], [50]-[63] : rule heads (variables, NO paths)
// ============================================================================

// [15] HeadTemplate ::= '{' HeadTemplateBlock? '}'
head_template: "{" triples_block_template? "}"

// [51] TriplesBlockTemplate ::= TriplesSameSubjectTemplate ( '.' TriplesBlockTemplate? )?
triples_block_template: triples_same_subject_template ("." triples_block_template?)?

// [52] TriplesSameSubjectTemplate ::= VarOrRDFTerm PropertyListNotEmptyTemplate
triples_same_subject_template: var_or_rdf_term property_list_not_empty_template

// [54] PropertyListNotEmptyTemplate ::= Verb ObjectListTemplate ( ';' ( Verb ObjectListTemplate )? )*
property_list_not_empty_template: verb object_list_template (";" (verb object_list_template)?)*

// [55] ObjectListTemplate ::= ObjectTemplate ( ',' ObjectTemplate )*
object_list_template: object_template ("," object_template)*

// [56] ObjectTemplate ::= GraphNodeTemplate
object_template: graph_node_template

// [57] GraphNodeTemplate ::= VarOrRDFTerm
graph_node_template: var_or_rdf_term

// ============================================================================
// Pattern family [16], [64]-[91] : rule bodies (variables AND paths)
// ============================================================================

// [16] BodyPattern ::= '{' BodyTriplesBlock? ( BodyNotTriples '.'? BodyTriplesBlock? )* '}'
body_pattern: "{" body_triples_block? (body_not_triples "."? body_triples_block?)* "}"

// [17] BodyNotTriples ::= Filter | Negation | Assignment
body_not_triples: filter | negation | assignment

// [18] Filter ::= 'FILTER' Constraint
filter: "FILTER"i constraint

// [19] Constraint ::= BrackettedExpression | BuiltInCall | FunctionCall
constraint: bracketted_expression | built_in_call | function_call

// [20] FunctionCall ::= iri ArgList
function_call: iri arg_list

// [21] ArgList ::= NIL | '(' Expression ( ',' Expression )* ')'
arg_list: NIL | "(" expression ("," expression)* ")"

// [22] ExpressionList ::= NIL | '(' Expression ( ',' Expression )* ')'
expression_list: NIL | "(" expression ("," expression)* ")"

// [23] Negation ::= 'NOT' '{' BodyBasic '}'
negation: "NOT"i "{" body_basic "}"

// [24] BodyBasic ::= BodyTriplesBlock? ( BodyBasicNotTriples '.'? BodyTriplesBlock? )*
body_basic: body_triples_block? (body_basic_not_triples "."? body_triples_block?)*

// [25] BodyBasicNotTriples ::= Filter
body_basic_not_triples: filter

// [26] Assignment ::= 'SET' '(' Var ':=' Expression ')'
// ASSIGN_OP is a named terminal (priority 2) so ':=' is not mis-lexed as a
// PNAME_NS colon followed by '='.
assignment: "SET"i "(" var ASSIGN_OP expression ")"
ASSIGN_OP.2: ":="

// [64] BodyTriplesBlock ::= TriplesBlockPattern
body_triples_block: triples_block_pattern

// [65] TriplesBlockPattern ::= TriplesSameSubjectPattern ( '.' TriplesBlockPattern? )?
triples_block_pattern: triples_same_subject_pattern ("." triples_block_pattern?)?

// [67] TriplesSameSubjectPattern ::= VarOrRDFTerm PropertyListNotEmptyPattern
triples_same_subject_pattern: var_or_rdf_term property_list_not_empty_pattern

// [69] PropertyListNotEmptyPattern ::= ( VerbPath | Var ) ObjectListPattern ( ';' ( ( VerbPath | Var ) ObjectListPattern )? )*
property_list_not_empty_pattern: (verb_path | verb_simple) object_list_pattern (";" ((verb_path | verb_simple) object_list_pattern)?)*

// [70] ObjectListPattern ::= ObjectPattern ( ',' ObjectPattern )*
object_list_pattern: object_pattern ("," object_pattern)*

// [71] ObjectPattern ::= GraphNodePattern
object_pattern: graph_node_pattern

// [77] GraphNodePattern ::= VarOrRDFTerm
graph_node_pattern: var_or_rdf_term

// [86] Verb ::= VarOrIri | 'a'
verb: var_or_iri | TYPE_A

// [87] VerbPath ::= Path
verb_path: path
// VerbSimple ::= Var (predicate-position variable)
verb_simple: var

// [88] Path ::= PathSequence
path: path_sequence
// [89] PathSequence ::= PathEltOrInverse ( '/' PathEltOrInverse )*
path_sequence: path_elt_or_inverse ("/" path_elt_or_inverse)*
// [90] PathEltOrInverse ::= PathElt | '^' PathElt
path_elt_or_inverse: path_elt | CARET path_elt
CARET: "^"
// [91] PathElt ::= ( iri | 'a' | '(' Path ')' )
path_elt: iri | TYPE_A | "(" path ")"

// ============================================================================
// Triple terms (shared by template and pattern positions) [83]-[85]
// ============================================================================

// [83] TripleTerm ::= '<<(' TripleTermSubject Verb TripleTermObject ')>>'
triple_term: "<<(" triple_term_subject verb triple_term_object ")>>"
// [84] TripleTermSubject
triple_term_subject: var | iri | rdf_literal | numeric_literal | boolean_literal | blank_node | triple_term
// [85] TripleTermObject
triple_term_object: var | iri | rdf_literal | numeric_literal | boolean_literal | blank_node | triple_term

// ============================================================================
// Shared terms
// ============================================================================

// [93] VarOrRDFTerm ::= Var | iri | RDFLiteral | NumericLiteral | BooleanLiteral | BlankNode | NIL | TripleTerm
var_or_rdf_term: var | iri | rdf_literal | numeric_literal | boolean_literal | blank_node | NIL | triple_term

// [94] VarOrIri ::= Var | iri
var_or_iri: var | iri

// [95] Var ::= VAR1 | VAR2
var: VAR1 | VAR2

// [99] iri ::= IRIREF | PrefixedName
iri: IRIREF | prefixed_name

// [104] PrefixedName ::= PNAME_LN | PNAME_NS
prefixed_name: PNAME_LN | PNAME_NS

// [105] BlankNode ::= BLANK_NODE_LABEL | ANON
blank_node: BLANK_NODE_LABEL | ANON

// ============================================================================
// Expressions [106]-[121]
// ============================================================================

OR_OP: "||"
AND_OP: "&&"
EQ_OP: "="
NE_OP: "!="
LE_OP: "<="
GE_OP: ">="
LT_OP: "<"
GT_OP: ">"
PLUS_OP: "+"
MINUS_OP: "-"
TIMES_OP: "*"
DIV_OP: "/"
BANG_OP: "!"
IN_KW: "IN"i
NOT_KW: "NOT"i

// [106] Expression ::= ConditionalOrExpression
expression: conditional_or_expression
// [107] ConditionalOrExpression
conditional_or_expression: conditional_and_expression (OR_OP conditional_and_expression)*
// [108] ConditionalAndExpression
conditional_and_expression: value_logical (AND_OP value_logical)*
// [109] ValueLogical ::= RelationalExpression
value_logical: relational_expression
// [110] RelationalExpression
relational_expression: numeric_expression ((EQ_OP | NE_OP | LT_OP | GT_OP | LE_OP | GE_OP) numeric_expression | IN_KW expression_list | NOT_KW IN_KW expression_list)?
// [111] NumericExpression ::= AdditiveExpression
numeric_expression: additive_expression
// [112] AdditiveExpression
additive_expression: multiplicative_expression ((PLUS_OP | MINUS_OP) multiplicative_expression | (numeric_literal_positive | numeric_literal_negative) ((TIMES_OP | DIV_OP) unary_expression)*)*
// [113] MultiplicativeExpression
multiplicative_expression: unary_expression ((TIMES_OP | DIV_OP) unary_expression)*
// [114] UnaryExpression
unary_expression: BANG_OP primary_expression
                | PLUS_OP primary_expression
                | MINUS_OP primary_expression
                | primary_expression
// [115] PrimaryExpression
primary_expression: bracketted_expression
                  | built_in_call
                  | iri_or_function
                  | rdf_literal
                  | numeric_literal
                  | boolean_literal
                  | var
                  | expr_triple_term
// [117] ExprTripleTerm ::= '<<(' ExprTripleTermSubject Verb ExprTripleTermObject ')>>'
expr_triple_term: "<<(" expr_triple_term_subject verb expr_triple_term_object ")>>"
// [118] ExprTripleTermSubject
expr_triple_term_subject: iri | rdf_literal | numeric_literal | boolean_literal | var
// [119] ExprTripleTermObject
expr_triple_term_object: iri | rdf_literal | numeric_literal | boolean_literal | var | expr_triple_term
// [120] BrackettedExpression ::= '(' Expression ')'
bracketted_expression: "(" expression ")"

// [121] BuiltInCall  (exactly the spec's list; NO BOUND/RAND/MD5/SHA*/COALESCE/EXISTS)
built_in_call: builtin_str
             | builtin_lang
             | builtin_langmatches
             | builtin_langdir
             | builtin_datatype
             | builtin_iri
             | builtin_uri
             | builtin_bnode
             | builtin_abs
             | builtin_ceil
             | builtin_floor
             | builtin_round
             | builtin_concat
             | builtin_substr
             | builtin_strlen
             | builtin_replace
             | builtin_ucase
             | builtin_lcase
             | builtin_encode_for_uri
             | builtin_contains
             | builtin_strstarts
             | builtin_strends
             | builtin_strbefore
             | builtin_strafter
             | builtin_year
             | builtin_month
             | builtin_day
             | builtin_hours
             | builtin_minutes
             | builtin_seconds
             | builtin_timezone
             | builtin_tz
             | builtin_now
             | builtin_uuid
             | builtin_struuid
             | builtin_if
             | builtin_strlang
             | builtin_strlangdir
             | builtin_strdt
             | builtin_sameterm
             | builtin_isiri
             | builtin_isuri
             | builtin_isblank
             | builtin_isliteral
             | builtin_isnumeric
             | builtin_haslang
             | builtin_haslangdir
             | builtin_regex
             | builtin_istriple
             | builtin_triple
             | builtin_subject
             | builtin_predicate
             | builtin_object

builtin_str: "STR"i "(" expression ")"
builtin_lang: "LANG"i "(" expression ")"
builtin_langmatches: "LANGMATCHES"i "(" expression "," expression ")"
builtin_langdir: "LANGDIR"i "(" expression ")"
builtin_datatype: "DATATYPE"i "(" expression ")"
builtin_iri: "IRI"i "(" expression ")"
builtin_uri: "URI"i "(" expression ")"
builtin_bnode: "BNODE"i ("(" expression ")" | NIL)
builtin_abs: "ABS"i "(" expression ")"
builtin_ceil: "CEIL"i "(" expression ")"
builtin_floor: "FLOOR"i "(" expression ")"
builtin_round: "ROUND"i "(" expression ")"
builtin_concat: "CONCAT"i expression_list
builtin_substr: "SUBSTR"i "(" expression "," expression ("," expression)? ")"
builtin_strlen: "STRLEN"i "(" expression ")"
builtin_replace: "REPLACE"i "(" expression "," expression "," expression ("," expression)? ")"
builtin_ucase: "UCASE"i "(" expression ")"
builtin_lcase: "LCASE"i "(" expression ")"
builtin_encode_for_uri: "ENCODE_FOR_URI"i "(" expression ")"
builtin_contains: "CONTAINS"i "(" expression "," expression ")"
builtin_strstarts: "STRSTARTS"i "(" expression "," expression ")"
builtin_strends: "STRENDS"i "(" expression "," expression ")"
builtin_strbefore: "STRBEFORE"i "(" expression "," expression ")"
builtin_strafter: "STRAFTER"i "(" expression "," expression ")"
builtin_year: "YEAR"i "(" expression ")"
builtin_month: "MONTH"i "(" expression ")"
builtin_day: "DAY"i "(" expression ")"
builtin_hours: "HOURS"i "(" expression ")"
builtin_minutes: "MINUTES"i "(" expression ")"
builtin_seconds: "SECONDS"i "(" expression ")"
builtin_timezone: "TIMEZONE"i "(" expression ")"
builtin_tz: "TZ"i "(" expression ")"
builtin_now: "NOW"i NIL
builtin_uuid: "UUID"i NIL
builtin_struuid: "STRUUID"i NIL
builtin_if: "IF"i "(" expression "," expression "," expression ")"
builtin_strlang: "STRLANG"i "(" expression "," expression ")"
builtin_strlangdir: "STRLANGDIR"i "(" expression "," expression "," expression ")"
builtin_strdt: "STRDT"i "(" expression "," expression ")"
builtin_sameterm: "sameTerm"i "(" expression "," expression ")"
builtin_isiri: "isIRI"i "(" expression ")"
builtin_isuri: "isURI"i "(" expression ")"
builtin_isblank: "isBLANK"i "(" expression ")"
builtin_isliteral: "isLITERAL"i "(" expression ")"
builtin_isnumeric: "isNUMERIC"i "(" expression ")"
builtin_haslang: "hasLANG"i "(" expression ")"
builtin_haslangdir: "hasLANGDIR"i "(" expression ")"
builtin_regex: "REGEX"i "(" expression "," expression ("," expression)? ")"
builtin_istriple: "isTRIPLE"i "(" expression ")"
builtin_triple: "TRIPLE"i "(" expression "," expression "," expression ")"
builtin_subject: "SUBJECT"i "(" expression ")"
builtin_predicate: "PREDICATE"i "(" expression ")"
builtin_object: "OBJECT"i "(" expression ")"

// [116] iriOrFunction ::= iri ArgList?
iri_or_function: iri arg_list?

// [96] RDFLiteral ::= String ( LANG_DIR | '^^' iri )?
rdf_literal: string (LANG_DIR | "^^" iri)?

// [97] NumericLiteral
numeric_literal: numeric_literal_unsigned | numeric_literal_positive | numeric_literal_negative
// [98] NumericLiteralUnsigned
numeric_literal_unsigned: INTEGER | DECIMAL | DOUBLE
// [99] NumericLiteralPositive
numeric_literal_positive: INTEGER_POSITIVE | DECIMAL_POSITIVE | DOUBLE_POSITIVE
// [100] NumericLiteralNegative
numeric_literal_negative: INTEGER_NEGATIVE | DECIMAL_NEGATIVE | DOUBLE_NEGATIVE

// [101] BooleanLiteral ::= 'true' | 'false'
boolean_literal: TRUE | FALSE

// [102] String
string: STRING_LITERAL1 | STRING_LITERAL2 | STRING_LITERAL_LONG1 | STRING_LITERAL_LONG2

// ============================================================================
// TERMINALS [122]-[156]
// ============================================================================

// 'a' is the rdf:type shorthand. Named terminal (not an inline literal) so Lark
// keeps it in the tree; priority 2 so a standalone `a` in verb/path position
// wins over prefixed-name lexing.
TYPE_A.2: "a"

TRUE: "true"i
FALSE: "false"i

// [143] UCHAR ::= ('\u' HEX HEX HEX HEX) | ('\U' HEX HEX HEX HEX HEX HEX HEX HEX)
UCHAR: /\\u[0-9A-Fa-f]{4}/ | /\\U[0-9A-Fa-f]{8}/

// [122] IRIREF ::= '<' ([^<>"{}|^`\]-[#x00-#x20] | UCHAR)* '>'
IRIREF: "<" (/[^\x00-\x20<>"{}|^`\\]/ | UCHAR)* ">"

// [123] PNAME_NS ::= PN_PREFIX? ':'
PNAME_NS: PN_PREFIX? ":"
// [124] PNAME_LN ::= PNAME_NS PN_LOCAL
PNAME_LN: PNAME_NS PN_LOCAL
// [125] BLANK_NODE_LABEL
BLANK_NODE_LABEL: "_:" (PN_CHARS_U | /[0-9]/) ((PN_CHARS | ".")* PN_CHARS)?
// [126] VAR1 ::= '?' VARNAME
VAR1: "?" VARNAME
// [127] VAR2 ::= '$' VARNAME
VAR2: "$" VARNAME
// [128] LANG_DIR ::= '@' [a-zA-Z]+ ('-' [a-zA-Z0-9]+)* ('--' [a-zA-Z]+)?
LANG_DIR: "@" /[a-zA-Z]+/ ("-" /[a-zA-Z0-9]+/)* ("--" /[a-zA-Z]+/)?
// [129] INTEGER
INTEGER: /[0-9]+/
// [130] DECIMAL
DECIMAL: /[0-9]*/ "." /[0-9]+/
// [131] DOUBLE
DOUBLE: ((/[0-9]+/ ("." /[0-9]*/)?) | ("." /[0-9]+/)) /[eE][+-]?[0-9]+/
// [132]-[137]
INTEGER_POSITIVE: "+" INTEGER
DECIMAL_POSITIVE: "+" DECIMAL
DOUBLE_POSITIVE: "+" DOUBLE
INTEGER_NEGATIVE: "-" INTEGER
DECIMAL_NEGATIVE: "-" DECIMAL
DOUBLE_NEGATIVE: "-" DOUBLE
// [138] STRING_LITERAL1
STRING_LITERAL1: "'" (/[^\x27\x5C\x0A\x0D]/ | ECHAR | UCHAR)* "'"
// [139] STRING_LITERAL2
STRING_LITERAL2: "\"" (/[^\x22\x5C\x0A\x0D]/ | ECHAR | UCHAR)* "\""
// [140] STRING_LITERAL_LONG1
STRING_LITERAL_LONG1: "'''" (("'" | "''")? (/[^'\\]/ | ECHAR | UCHAR))* "'''"
// [141] STRING_LITERAL_LONG2
STRING_LITERAL_LONG2: "\"\"\"" (("\"" | "\"\"")? (/[^"\\]/ | ECHAR | UCHAR))* "\"\"\""
// [142] ECHAR ::= '\' [tbnrf\"']
ECHAR: "\\" /[tbnrf\\"']/
// [144] NIL ::= '(' WS* ')'
NIL.9: "(" /[\x20\x09\x0D\x0A]*/ ")"
// [146] ANON ::= '[' WS* ']'
ANON.9: "[" /[\x20\x09\x0D\x0A]*/ "]"
// [147] PN_CHARS_BASE
PN_CHARS_BASE: /[A-Za-z\u00C0-\u00D6\u00D8-\u00F6\u00F8-\u02FF\u0370-\u037D\u037F-\u1FFF\u200C-\u200D\u2070-\u218F\u2C00-\u2FEF\u3001-\uD7FF\uF900-\uFDCF\uFDF0-\uFFFD]/ | /[\U00010000-\U000EFFFF]/
// [148] PN_CHARS_U ::= PN_CHARS_BASE | '_'
PN_CHARS_U: PN_CHARS_BASE | "_"
// [149] VARNAME
VARNAME: (PN_CHARS_U | /[0-9]/) (PN_CHARS_U | /[0-9]/ | "\u00B7" | /[\u0300-\u036F]/ | /[\u203F-\u2040]/)*
// [150] PN_CHARS
PN_CHARS: PN_CHARS_U | "-" | /[0-9]/ | "\u00B7" | /[\u0300-\u036F]/ | /[\u203F-\u2040]/
// [151] PN_PREFIX
PN_PREFIX: PN_CHARS_BASE ((PN_CHARS | ".")* PN_CHARS)?
// [152] PN_LOCAL
PN_LOCAL: (PN_CHARS_U | ":" | /[0-9]/ | PLX) ((PN_CHARS | "." | ":" | PLX)* (PN_CHARS | ":" | PLX))?
// [153] PLX
PLX: PERCENT | PN_LOCAL_ESC
// [154] PERCENT
PERCENT: "%" HEX HEX
// [155] HEX
HEX: /[0-9A-Fa-f]/
// [156] PN_LOCAL_ESC
PN_LOCAL_ESC: "\\" /[_~.\-!$&'()*+,;=\/?#@%]/

// Whitespace and comments
%import common.WS
%ignore WS
COMMENT: "#" /[^\n]*/
%ignore COMMENT
